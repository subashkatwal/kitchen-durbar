# Copy this file to .env and adjust values as needed.
# `docker compose up` reads .env automatically.

# --- PostgreSQL ---
POSTGRES_DB=kitchendurbar
POSTGRES_USER=kitchendurbar
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173

# Optional: bootstrap a Django admin (superuser) on first backend start.
# Leave blank to skip and create one manually with `manage.py createsuperuser`.
DJANGO_SUPERUSER_EMAIL=admin@kitchendurbar.com
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_NAME=Admin User

# --- Google Sign-In ---
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials, add your frontend
# origin(s) as Authorized JavaScript origins, then fill these in.
# GOOGLE_CLIENT_ID and VITE_GOOGLE_CLIENT_ID must be the SAME value.
# Leave blank to leave Google sign-in disabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Frontend ---
# Used by the Vite dev server (docker-compose.override.yml) at runtime,
# and baked into the production build via Dockerfile build args.
VITE_API_URL=http://localhost:8000/api/v1
VITE_WHATSAPP_NUMBER=+9779769400796
VITE_GOOGLE_CLIENT_ID=
